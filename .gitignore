# build output
dist/
.wrangler/

# generated theme assets — the zip is a release artifact, not a commit
ghost/assets/built/

# install-specific: maps the design's /img/ paths to one Ghost's uploaded URLs
scripts/ghost/uploaded-images.json

# generated types
.astro/

# harness python deps — homebrew python refuses a system install (PEP 668)
.venv/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# the cached Ghost owner session; a credential, and per-install
.ghost-session.json

# macOS-specific files
.DS_Store

# verification harness working files
.shots/
.originals/
.profiles/
panel-*.png
__pycache__/
