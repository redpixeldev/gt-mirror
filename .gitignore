# build output
dist/
.wrangler/

# generated theme assets — the zip is a release artifact, not a commit
ghost/assets/built/

# install-specific: maps the design's /img/ paths to one Ghost's uploaded URLs. The Day-one
# publication has no images, so its map is always empty.
scripts/ghost/uploaded-images.json
scripts/ghost/fixture-day-one-images.json

# generated types
.astro/

# harness python deps — homebrew python refuses a system install (PEP 668)
.venv/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# the cached Ghost owner session; a credential, and per-install — one per Ghost
.ghost-session.json
.ghost-session-day-one.json
.ghost-session-demo.json

# macOS-specific files
.DS_Store

# verification harness working files
.shots/
.originals/
.profiles/
panel-*.png
__pycache__/
