{{!< default}}

{{!-- Recommendations. Ghost resolves page-{slug}.hbs first, then a custom template chosen in the
page settings menu, then page.hbs — so page-recommendations.hbs keeps the demo slug working while
custom-recommendations.hbs lets a buyer apply the same layout to a page named anything at all. One
partial, no duplicated markup. --}}

{{> "chrome/header" compact=true}}

<main
	id="main"
	class="grow"
	data-surface="page-recommendations">

	{{> "pages/recommendations"}}

</main>

{{> "chrome/footer"}}
