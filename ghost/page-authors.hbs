{{!< default}}

{{!-- The Authors Directory. Ghost resolves page-{slug}.hbs first, then a custom template chosen
in the page settings menu, then page.hbs — so page-authors.hbs keeps the demo slug working while
custom-authors.hbs lets a buyer apply the same layout to a page named anything at all. One
partial, no duplicated markup. --}}

{{> "chrome/header"}}

<main
	id="main"
	class="grow"
	data-surface="page-authors"
	data-layout="{{#match @custom.directory_layout "Cover cards"}}Cover cards{{else}}Editorial rows{{/match}}">

	{{> "pages/authors" layout=@custom.directory_layout}}

</main>

{{> "chrome/footer"}}
