{{!< default}}

{{!-- Membership. Ghost resolves page-{slug}.hbs first, then a custom template chosen in the
page settings menu, then page.hbs — so page-membership.hbs keeps the demo slug working while
custom-membership.hbs lets a buyer apply the same layout to a page named anything at all. One
partial, no duplicated markup. --}}

{{> "chrome/header"}}

<main
	id="main"
	class="grow"
	data-surface="page-membership"
	data-layout="{{#match @custom.page_hero "Split hero"}}Split hero{{else}}Centered statement{{/match}}">

	{{> "pages/membership" layout=@custom.page_hero}}

</main>

{{> "chrome/footer"}}
