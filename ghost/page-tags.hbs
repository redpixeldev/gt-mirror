{{!< default}}

{{!-- The Tags Directory. Ghost resolves page-{slug}.hbs first, then a custom template chosen in
the page settings menu, then page.hbs — so page-tags.hbs keeps the demo slug working while
custom-tags.hbs lets a buyer apply the same layout to a page named anything at all. One partial,
no duplicated markup. --}}

{{> "chrome/header"}}

<main
	id="main"
	class="grow"
	data-surface="page-tags"
	data-layout="{{#match @custom.directory_layout "Cover cards"}}Cover cards{{else}}Editorial rows{{/match}}">

	{{> "pages/tags" layout=@custom.directory_layout}}

</main>

{{> "chrome/footer"}}
