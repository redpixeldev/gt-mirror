{{!-- A2, "three-column grid": a card per post, at page width.

Same posts, same order, same byline — the grid is the whole of what distinguishes this layout
from A1, which is why both read `posts` directly and neither queries anything.

The full byline runs on one line here (writer · date · reading time) where A1 draws the writer's
face beside it, so this card has no avatar. --}}
<section
	aria-label="{{t "Posts"}}"
	class="container pt-12">
	<div class="grid grid-cols-[repeat(auto-fill,minmax(min(320px,100%),1fr))] gap-x-10 gap-y-13">
		{{#foreach posts}}
			<article class="{{post_class}}">
				<a
					href="{{url}}"
					class="text-text block no-underline">
					{{#if feature_image}}
						<img
							src="{{img_url feature_image size="m"}}"
							{{> "image-srcset" image=feature_image sizes="(min-width: 768px) 460px, 100vw"}}
							{{#if feature_image_alt}}alt="{{feature_image_alt}}"{{else}}alt=""{{/if}}
							loading="lazy"
							decoding="async"
							class="border-border block aspect-[4/3] w-full rounded-md border object-cover">
					{{/if}}

					<div class="mt-[18px] flex items-center gap-2.5">
						{{#primary_tag}}
							<span class="font-meta text-meta tracking-meta text-accent uppercase">{{name}}</span>
						{{/primary_tag}}

						{{> "tier-chip"}}
					</div>

					<h2 class="font-display tracking-heading mt-3 text-2xl leading-[1.22] font-medium text-balance">{{title}}</h2>

					<p class="text-small text-muted mt-3 leading-[1.58]">{{excerpt}}</p>

					<p class="font-meta text-meta tracking-meta text-muted mt-4 uppercase">
						{{~#if authors}}{{> "byline"}}<span aria-hidden="true"> · </span>{{/if~}}
						{{> "dateline"}}
					</p>
				</a>
			</article>
		{{else}}
			<p class="font-body text-muted">{{t "No posts yet."}}</p>
		{{/foreach}}
	</div>
</section>
