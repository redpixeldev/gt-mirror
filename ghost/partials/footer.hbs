{{!-- Skeleton chrome — see partials/header.hbs. Columns from the secondary navigation
menu and the designed wordmark land in the Chrome ticket. --}}
<footer class="border-border mt-24 border-t">
    <div class="container flex flex-col gap-4 py-10 md:flex-row md:items-center md:justify-between">
        <p class="font-meta text-muted text-[12px]">
            &copy; {{date format="YYYY"}} {{@site.title}}
        </p>

        <nav
            class="font-ui text-[13px]"
            aria-label="{{t "Secondary navigation"}}">{{navigation type="secondary"}}</nav>

        <a
            href="{{@site.url}}rss/"
            class="font-meta text-muted text-[12px]">{{t "RSS"}}</a>
    </div>
</footer>
