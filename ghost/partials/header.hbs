{{!-- Skeleton chrome. It is wired to the publication's own data — {{@site.title}} and
the editable navigation menu — so the Chrome ticket restyles this rather than rewiring it.
The compact variant, the mobile overlay and the search handoff land there too. --}}
<header class="border-border bg-bg-90 sticky top-0 z-40 border-b backdrop-blur">
    <div class="container flex items-center justify-between gap-6 py-4">
        <a
            href="{{@site.url}}"
            class="font-display text-h3 text-text tracking-tight no-underline">{{@site.title}}</a>

        <nav
            class="font-ui hidden text-[13px] nav:block"
            aria-label="{{t "Main navigation"}}">{{navigation}}</nav>

        {{> "theme-toggle"}}
    </div>
</header>
