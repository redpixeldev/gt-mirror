{{!-- The Mode switch — light or dark. All state lives in the `theme` Alpine store (assets/js/main.js),
which owns the `.dark` class on <html> and its localStorage mirror. The label is
server-rendered as the publication's default_appearance; Alpine corrects it on boot when
the visitor's stored choice or their OS says otherwise. --}}
<button
	type="button"
	x-data
	x-bind:aria-pressed="$store.mode.dark"
	aria-pressed="false"
	aria-label="{{t "Toggle dark mode"}}"
	class="btn rounded-pill border-border bg-surface font-ui text-text flex cursor-pointer items-center gap-[9px] border px-4 py-2 text-[13px] font-medium shadow-sm hover:bg-surface-2"
	@click="$store.mode.toggle()">
	<span
		aria-hidden="true"
		class="bg-accent size-3 rounded-full"
		style="box-shadow: inset -4px 0 0 0 var(--mirror-dot-inset)"></span>
	<span x-text="$store.mode.label">{{#match @custom.default_appearance "Dark"}}{{t "Dark"}}{{else}}{{t "Light"}}{{/match}}</span>
</button>
