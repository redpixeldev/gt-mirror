{{!-- About. Shared by page-about.hbs and custom-about.hbs so no markup is duplicated.
The split hero, the stats grid and the masthead arrive with the Standing Pages ticket;
the derived counts there come from {{#get}} block-param totals, not from a fixture. --}}
{{#post}}
	<article class="{{post_class}} container py-16" data-surface="page-about">
		{{#if @page.show_title_and_feature_image}}
			<header class="measure mx-auto mb-10">
				<p class="font-meta text-muted text-[12px] uppercase">{{t "About"}}</p>
				<h1 class="font-display text-h1 text-text mt-3 tracking-tight">{{title}}</h1>
			</header>
		{{/if}}

		<div class="mirror-content measure mx-auto">
			{{content}}
		</div>
	</article>
{{/post}}
