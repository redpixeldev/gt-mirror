{
	"name": "astro-tailwindcss-starter",
	"type": "module",
	"version": "0.0.1",
	"license": "MIT",
	"packageManager": "pnpm@10.25.0",
	"scripts": {
		"develop": "astro dev",
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"ghost:css": "cd ghost && tailwindcss -i assets/css/screen.css -o assets/built/screen.css --minify && cd .. && node scripts/ghost/rewrite-font-urls.mjs",
		"ghost:js": "esbuild ghost/assets/js/main.js --bundle --minify --outfile=ghost/assets/built/main.js",
		"ghost:vendor": "node scripts/ghost/copy-microlighter.mjs",
		"ghost:i18n": "node scripts/ghost/check-locales.mjs",
		"ghost:build": "pnpm ghost:css && pnpm ghost:js && pnpm ghost:vendor && pnpm ghost:i18n",
		"ghost:dev": "concurrently --names css,js \"node scripts/ghost/watch-css.mjs\" \"esbuild ghost/assets/js/main.js --bundle --outfile=ghost/assets/built/main.js --watch\"",
		"ghost:scan": "gscan --fatal --verbose ghost/",
		"ghost:audit": "node --env-file=.env scripts/ghost/audit.mjs",
		"ghost:stage": "rm -rf dist/mirror && mkdir -p dist/mirror && rsync -a --exclude '.DS_Store' --exclude 'assets/css/' --exclude 'assets/js/' ghost/ dist/mirror/",
		"ghost:zip": "pnpm ghost:build && pnpm ghost:scan && pnpm ghost:stage && (cd dist && zip -rq mirror.zip mirror) && gscan --fatal -z dist/mirror.zip",
		"verify:venv": "python3 -m venv .venv && .venv/bin/python3 -m pip install -q pillow numpy",
		"verify:smoke": ".venv/bin/python3 scripts/verify/smoke.py --base http://localhost:4380 --routes scripts/verify/routes.json",
		"verify:prep": ".venv/bin/python3 scripts/verify/prep_originals.py --config scripts/verify/prep.json --clean",
		"verify:prep:gate": ".venv/bin/python3 scripts/verify/prep_originals.py --config scripts/verify/prep-paywalled.json",
		"verify:serve": "cd .originals && ../.venv/bin/python3 -m http.server 4394 --bind 127.0.0.1",
		"verify:shots": ".venv/bin/python3 scripts/verify/shoot.py --jobs scripts/verify/baseline-jobs.json --out-dir . --base http://localhost:4380",
		"verify:shots:orig": ".venv/bin/python3 scripts/verify/shoot.py --jobs scripts/verify/baseline-orig-jobs.json --out-dir .shots",
		"verify:score": ".venv/bin/python3 scripts/verify/report.py --index scripts/verify/baseline-index.json --floors scripts/verify/baseline-scores.json",
		"verify:floors": ".venv/bin/python3 scripts/verify/report.py --index scripts/verify/baseline-index.json --floors scripts/verify/baseline-scores.json --capture-field orig",
		"ghost:smoke": ".venv/bin/python3 scripts/verify/smoke.py --base http://localhost:2368 --routes scripts/ghost/routes.json",
		"ghost:smoke:bare": ".venv/bin/python3 scripts/verify/smoke.py --base http://localhost:2368 --routes scripts/ghost/routes-bare.json",
		"ghost:routes": "node --env-file=.env scripts/ghost/build-routes.mjs",
		"ghost:routes:apply": "node --env-file=.env scripts/ghost/upload-routes.mjs",
		"ghost:routes:bare": "node --env-file=.env scripts/ghost/upload-routes.mjs --bare",
		"ghost:fixture": "node scripts/ghost/build-fixture.mjs",
		"ghost:import": "node --env-file=.env scripts/ghost/import.mjs",
		"ghost:import:fresh": "node --env-file=.env scripts/ghost/import.mjs --prune",
		"ghost:verify": "node --env-file=.env scripts/ghost/verify-fixture.mjs",
		"ghost:idempotence": "node --env-file=.env scripts/ghost/check-idempotence.mjs",
		"ghost:access": "node --env-file=.env scripts/ghost/check-access.mjs",
		"ghost:jobs": "node scripts/ghost/build-jobs.mjs",
		"ghost:shots": ".venv/bin/python3 scripts/verify/shoot.py --jobs scripts/ghost/jobs.json --out-dir .shots/ghost",
		"ghost:score": "node --env-file=.env scripts/ghost/score.mjs",
		"ghost:demo": "node scripts/ghost/build-demo-zip.mjs",
		"day-one:fixture": "GHOST_URL=http://localhost:2369 node scripts/ghost/build-day-one.mjs",
		"day-one:import": "GHOST_URL=http://localhost:2369 GHOST_SESSION_FILE=.ghost-session-day-one.json node --env-file=.env scripts/ghost/import.mjs --fixture scripts/ghost/fixture-day-one.json --prune",
		"day-one:routes": "GHOST_URL=http://localhost:2369 GHOST_SESSION_FILE=.ghost-session-day-one.json node --env-file=.env scripts/ghost/upload-routes.mjs --small",
		"day-one:routes:bare": "GHOST_URL=http://localhost:2369 GHOST_SESSION_FILE=.ghost-session-day-one.json node --env-file=.env scripts/ghost/upload-routes.mjs --bare",
		"day-one:smoke": ".venv/bin/python3 scripts/verify/smoke.py --base http://localhost:2369 --routes scripts/ghost/routes-day-one.json",
		"day-one:smoke:bare": ".venv/bin/python3 scripts/verify/smoke.py --base http://localhost:2369 --routes scripts/ghost/routes-day-one-bare.json",
		"day-one:audit": "GHOST_URL=http://localhost:2369 GHOST_SESSION_FILE=.ghost-session-day-one.json node --env-file=.env scripts/ghost/audit.mjs --surfaces scripts/ghost/audit-day-one.json",
		"day-one:shots": "GHOST_URL=http://localhost:2369 GHOST_SESSION_FILE=.ghost-session-day-one.json node --env-file=.env scripts/ghost/shoot-day-one.mjs",
		"day-one": "pnpm day-one:fixture && pnpm day-one:routes:bare && pnpm day-one:smoke:bare && pnpm day-one:routes && pnpm day-one:smoke && pnpm day-one:audit",
		"demo:import": "pnpm ghost:demo && GHOST_URL=http://localhost:2370 GHOST_SESSION_FILE=.ghost-session-demo.json node --env-file=.env scripts/ghost/import.mjs --fixture dist/mirror-demo-fixture.json --prune",
		"demo:routes": "GHOST_URL=http://localhost:2370 GHOST_SESSION_FILE=.ghost-session-demo.json node --env-file=.env scripts/ghost/upload-routes.mjs --routes dist/mirror-demo-routes.yaml",
		"demo:smoke": "node scripts/ghost/demo-smoke.mjs --base http://localhost:2370",
		"demo": "pnpm demo:import && pnpm demo:routes && pnpm demo:smoke"
	},
	"dependencies": {
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"astro": "^7.0.2",
		"swiper": "^11.2.10",
		"tailwindcss": "^4.3.1"
	},
	"devDependencies": {
		"@tailwindcss/cli": "^4.3.3",
		"@tailwindcss/vite": "^4.3.1",
		"@typescript-eslint/parser": "^8.62.0",
		"alpinejs": "^3.16.3",
		"concurrently": "^10.0.5",
		"esbuild": "^0.28.2",
		"eslint": "^10.5.0",
		"eslint-plugin-astro": "^2.1.1",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-tailwindcss": "^4.0.4",
		"gscan": "^6.4.2",
		"microlighter": "2.1.0",
		"prettier": "^3.8.4",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"sharp": "^0.35.2",
		"typescript": "^6.0.3",
		"wrangler": "^4.104.0"
	}
}
