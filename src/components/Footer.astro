---
/**
 * Site footer.
 *
 * Columns come from `data/navigation.ts` — a page passes only the variant label
 * that names the layout it is showing.
 */
import { FOOTER_COLUMNS, SITE_TAGLINE, SITE_TITLE, type FooterColumn } from '../data/navigation';
import Logo from './Logo.astro';

export type { FooterColumn, FooterLink } from '../data/navigation';

interface Props {
	siteTitle?: string;
	tagline?: string;
	/** Overrides the shared columns; no page needs to. */
	columns?: FooterColumn[];
	copyright?: string;
	/** Static prefix for the bottom-right rule; the theme label is appended live. */
	variantLabel?: string;
	/** The wordmark sits at the display weight on the homepage, semibold in the styleguide. */
	titleWeight?: 'medium' | 'semibold';
	class?: string;
}

const {
	siteTitle = SITE_TITLE,
	tagline = SITE_TAGLINE,
	columns = FOOTER_COLUMNS,
	copyright = `© 2026 ${SITE_TITLE} · MIRROR theme`,
	variantLabel = 'Variant A — Editorial',
	titleWeight = 'semibold',
	class: className,
} = Astro.props;
---

<footer
	id='footer'
	class:list={['border-border bg-surface border-t', className]}>
	<div class='container grid grid-cols-[repeat(auto-fit,minmax(min(190px,100%),1fr))] gap-9 py-14'>
		<div>
			<Logo height='h-4' />
			<p class='font-ui text-muted mt-3 text-[13.5px] leading-[1.6]'>{tagline}</p>
		</div>

		{
			columns.map((column) => (
				<nav aria-label={column.ariaLabel}>
					<p class='text-muted mb-3.5 font-mono text-[11px] tracking-[0.1em] uppercase'>{column.title}</p>
					<div class='flex flex-col gap-[9px]'>
						{column.links.map((link) => (
							<a
								href={link.href}
								class='font-ui text-text hover:text-accent text-sm no-underline'>
								{link.label}
							</a>
						))}
					</div>
				</nav>
			))
		}

		<div>
			<p class='text-muted mb-3.5 font-mono text-[11px] tracking-[0.1em] uppercase'>Newsletter</p>
			<form class='flex flex-wrap gap-2'>
				<label
					for='sg-footer-email'
					class='sr-only'>
					Email address
				</label>
				<input
					id='sg-footer-email'
					type='email'
					placeholder='Email'
					autocomplete='email'
					class='border-border bg-bg font-ui text-text min-w-0 flex-[1_1_130px] rounded-sm border px-3 py-2.5 text-sm'
				/>
				<button
					type='submit'
					class='btn btn-primary font-ui cursor-pointer rounded-sm px-4 py-2.5 text-sm font-semibold'>
					Join
				</button>
			</form>
		</div>
	</div>

	<div class='border-border border-t'>
		<div
			x-data
			class='container flex flex-wrap justify-between gap-4 py-5'>
			<span class='text-muted font-mono text-[11.5px]'>{copyright}</span>
			<span class='text-muted font-mono text-[11.5px]'>
				{variantLabel} · <span x-text='$store.theme.label'>Light</span>
			</span>
		</div>
	</div>
</footer>
