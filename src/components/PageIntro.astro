---
/**
 * Standard page opener: accent eyebrow, page title and a one-line summary.
 *
 * Shared by the masthead and recommendations templates, which differ only in
 * their section padding and the measure of the lead paragraph.
 */
interface Props {
	eyebrow: string;
	title: string;
	description: string;
	headingId: string;
	/** Section padding — 64/72 on the masthead, 64/56 on recommendations. */
	padding?: string;
	/** Lead measure — 58ch on the masthead, 60ch on recommendations. */
	measure?: string;
}

const { eyebrow, title, description, headingId, padding = 'pt-16 pb-18', measure = 'max-w-[58ch]' } = Astro.props;
---

<section
	aria-labelledby={headingId}
	class:list={['container', padding]}>
	<p class='text-accent font-mono text-[11px] tracking-[0.1em] uppercase'>{eyebrow}</p>

	<h1
		id={headingId}
		class='font-display tracking-display mt-[18px] text-[clamp(34px,4.4vw,56px)] leading-[1.06] font-medium'>
		{title}
	</h1>

	<p class:list={['text-lead text-muted mt-5 leading-[1.55] text-pretty', measure]}>{description}</p>
</section>
