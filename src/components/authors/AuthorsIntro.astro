---
/** Masthead page opener: eyebrow, page title and a one-line summary of the desk. */
interface Props {
	eyebrow?: string;
	title?: string;
	description: string;
	headingId?: string;
}

const { eyebrow = 'The masthead', title = 'Writers', description, headingId = 'au-title' } = Astro.props;
---

<section
	aria-labelledby={headingId}
	class='container pt-16 pb-18'>
	<p class='text-accent font-mono text-[11px] tracking-[0.1em] uppercase'>{eyebrow}</p>

	<h1
		id={headingId}
		class='font-display tracking-display mt-[18px] text-[clamp(34px,4.4vw,56px)] leading-[1.06] font-medium'>
		{title}
	</h1>

	<p class='text-lead text-muted mt-5 max-w-[58ch] leading-[1.55] text-pretty'>{description}</p>
</section>
