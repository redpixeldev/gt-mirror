---
/**
 * Tag filter + sort control. Buttons drive the `archive` Alpine scope; the active
 * pill inverts to the text colour, matching the source's `--all-*` variables.
 */
interface Props {
	tags: { name: string; count: number }[];
}

const { tags } = Astro.props;

const pill =
	'font-meta tracking-meta rounded-pill flex-none cursor-pointer border px-[15px] py-2 text-[12.5px] whitespace-nowrap uppercase';
/** Active pills invert; inactive keep the hairline border. */
const pillState = (expr: string) =>
	`${expr} ? 'bg-text text-surface border-text' : 'bg-transparent border-border text-text'`;
---

<section
	id='archive'
	aria-label='Filter and sort'
	class='container pt-9'>
	<div class='border-border flex flex-wrap items-center gap-5 border-b pb-4'>
		<div class='strip flex min-w-0 flex-[1_1_420px] gap-[9px] overflow-x-auto p-0.5'>
			<button
				type='button'
				class:list={[pill, 'text-muted']}
				x-bind:class={pillState('tag === null')}
				x-bind:aria-pressed='tag === null'
				aria-pressed='true'
				@click='tag = null'>
				All
			</button>

			{
				tags.map((t) => (
					<button
						type='button'
						class:list={[pill, 'border-border text-text bg-transparent']}
						x-bind:class={pillState(`tag === ${JSON.stringify(t.name)}`)}
						x-bind:aria-pressed={`tag === ${JSON.stringify(t.name)}`}
						aria-pressed='false'
						{...{ '@click': `tag = tag === ${JSON.stringify(t.name)} ? null : ${JSON.stringify(t.name)}` }}>
						{t.name} <span class='font-mono text-[11px] opacity-70'>{t.count}</span>
					</button>
				))
			}
		</div>

		<button
			type='button'
			class='btn border-border bg-surface font-ui text-text hover:bg-surface-2 flex flex-none cursor-pointer items-center gap-2 rounded-sm border px-4 py-[9px] text-[13px] font-semibold'
			@click='oldest = !oldest'>
			<span
				aria-hidden='true'
				class='text-muted font-mono text-[13px]'
				x-text="oldest ? '↑' : '↓'"
				>↓</span
			>
			<span x-text="oldest ? 'Oldest first' : 'Newest first'">Newest first</span>
		</button>
	</div>
</section>
