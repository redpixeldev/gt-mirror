---
/**
 * Tag filter + sort control. Buttons drive the `archive` Alpine scope.
 *
 * The active pill inverts to the text colour, matching the source's `--all-*`
 * variables. That inversion is styled from `aria-pressed` by the `tag-pill`
 * utility rather than swapped with `x-bind:class` — see the note on the utility
 * in `main.css` for why the class swap could not work. Alpine only flips the
 * attribute; it owns no colour here.
 */
interface Props {
	tags: { name: string; count: number }[];
}

const { tags } = Astro.props;

const pill =
	'tag-pill font-meta tracking-meta rounded-pill flex-none cursor-pointer border px-[15px] py-2 text-[12.5px] whitespace-nowrap uppercase';
---

<section
	id='archive'
	aria-label='Filter and sort'
	class='container pt-9'>
	<div class='border-border flex flex-wrap items-center gap-5 border-b pb-4'>
		<div class='strip flex min-w-0 flex-[1_1_420px] gap-[9px] p-0.5'>
			<button
				type='button'
				class={pill}
				x-bind:aria-pressed='tag === null'
				aria-pressed='true'
				@click='tag = null'>
				All
			</button>

			{
				tags.map((t) => (
					<button
						type='button'
						class={pill}
						x-bind:aria-pressed={`tag === ${JSON.stringify(t.name)}`}
						aria-pressed='false'
						{...{ '@click': `tag = tag === ${JSON.stringify(t.name)} ? null : ${JSON.stringify(t.name)}` }}>
						{t.name} <span class='font-mono text-[11px] opacity-70'>{t.count}</span>
					</button>
				))
			}
		</div>

		<button
			type='button'
			class='btn border-border bg-surface font-ui text-text hover:bg-surface-2 flex flex-none cursor-pointer items-center gap-2 rounded-sm border px-4 py-[9px] text-[13px] font-semibold'
			@click='oldest = !oldest'>
			<span
				aria-hidden='true'
				class='text-muted font-mono text-[13px]'
				x-text="oldest ? '↑' : '↓'"
				>↓</span
			>
			<span x-text="oldest ? 'Oldest first' : 'Newest first'">Newest first</span>
		</button>
	</div>
</section>
