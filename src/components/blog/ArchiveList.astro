---
import type { DecoratedPost } from '../../data/posts';
import ArchiveListItem from './ArchiveListItem.astro';

/**
 * A1 archive list.
 *
 * Every post is rendered once and filtered with `x-show`. Sorting re-appends the
 * rows in the new order rather than reordering them in CSS, so the DOM sequence
 * a screen reader follows always matches what is on screen.
 */
interface Props {
	posts: DecoratedPost[];
}

const { posts } = Astro.props;

const sort =
	'Array.from($el.children)' +
	'.sort((a, b) => (oldest ? -1 : 1) * (Number(a.dataset.order) - Number(b.dataset.order)))' +
	'.forEach((node) => $el.appendChild(node))';
---

<section
	aria-label='Posts'
	class='container pt-2'
	x-show='!isEmpty'>
	<div x-effect={sort}>
		{
			posts.map((post, i) => (
				<ArchiveListItem
					post={post}
					order={i}
				/>
			))
		}
	</div>
</section>
