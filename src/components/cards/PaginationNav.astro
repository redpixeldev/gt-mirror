---
/** Numbered pagination with an elided range. */
interface Props {
	/** Page entries; `'…'` renders the non-interactive gap marker. */
	pages?: (number | '…')[];
	current?: number;
	href?: string;
	/** Wraps the control in a surface card (the styleguide specimen); off on real pages. */
	framed?: boolean;
	/** `sm` is the styleguide's specimen sizing, `md` the one used in page templates. */
	size?: 'sm' | 'md';
}

const { pages = [1, 2, 3, '…', 9], current = 1, href = '#06', framed = true, size = 'sm' } = Astro.props;

const pageClass =
	size === 'sm'
		? 'rounded-sm border px-[15px] py-[9px] font-ui text-sm no-underline'
		: 'rounded-sm border px-4 py-2.5 font-ui text-sm no-underline';
const stepClass =
	size === 'sm'
		? 'rounded-sm border border-border px-3.5 py-[9px] font-ui text-sm no-underline'
		: 'rounded-sm border border-border px-[15px] py-2.5 font-ui text-sm no-underline';
---

<nav
	aria-label='Pagination'
	class:list={[
		'flex flex-wrap items-center justify-center gap-2',
		framed && 'border-border bg-surface rounded-md border p-5',
	]}>
	<a
		href={href}
		aria-label='Previous page'
		class:list={[stepClass, 'text-muted hover:bg-surface-2']}>
		<span aria-hidden='true'>←</span>
	</a>

	{
		pages.map((page) =>
			page === '…' ? (
				<span
					aria-hidden='true'
					class='text-muted px-1 font-mono text-[13px]'>
					…
				</span>
			) : (
				<a
					href={href}
					aria-current={page === current ? 'page' : undefined}
					class:list={[
						pageClass,
						page === current
							? 'border-accent bg-accent text-on-accent font-semibold'
							: 'border-border text-text hover:bg-surface-2',
					]}>
					{page}
				</a>
			),
		)
	}

	<a
		href={href}
		aria-label='Next page'
		class:list={[stepClass, 'text-text hover:bg-surface-2']}>
		<span aria-hidden='true'>→</span>
	</a>
</nav>
