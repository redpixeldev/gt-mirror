---
/** Koenig pull-quote: display face, centred in Variant A, breaking the reading pace. */
interface Props {
	quote?: string;
	caption?: string;
	margin?: string;
}

const {
	quote = "Pull quotes break the column and reset the reader's pace.",
	caption = 'Pull quote card',
	margin = 'mt-14',
} = Astro.props;
---

<figure class:list={['text-center', margin]}>
	<p class='font-display text-pull tracking-display text-text leading-[1.22] font-medium text-balance'>
		{quote}
	</p>
	<figcaption class='font-meta text-meta tracking-meta text-muted mt-[18px] uppercase'>{caption}</figcaption>
</figure>
