---
import type { DecoratedPost } from '../../data/posts';

/** Archive-grid card for A2: 5:4 image, tag, headline, meta — no excerpt. */
interface Props {
	post: DecoratedPost;
	href?: string;
}

const { post, href = '#latest' } = Astro.props;
---

<article>
	<a
		href={href}
		class='text-text block no-underline'>
		<img
			src={post.img}
			alt={post.alt}
			loading='lazy'
			decoding='async'
			class='border-border block aspect-[5/4] w-full rounded-md border object-cover'
		/>
		<p class='font-meta text-meta tracking-meta text-accent mt-4 uppercase'>{post.tag}</p>
		<h3 class='font-display tracking-heading mt-2.5 text-[23px] leading-[1.22] font-medium'>{post.title}</h3>
		<p class='font-meta text-meta tracking-meta text-muted mt-3 uppercase'>{post.meta}</p>
	</a>
</article>
