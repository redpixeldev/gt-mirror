---
import type { DecoratedPost } from '../../data/posts';
import { postHref } from '../../data/navigation';

/** Standard post card for the archive grid, with an optional membership tier chip. */
interface Props {
	post: DecoratedPost;
	href?: string;
}

const { post, href = postHref(post.locked) } = Astro.props;
---

<article>
	<a
		href={href}
		class='text-text block no-underline'>
		<img
			src={post.img}
			alt={post.alt}
			loading='lazy'
			decoding='async'
			class='border-border block aspect-[3/2] w-full rounded-md border object-cover'
		/>

		<div class='mt-4 flex items-center gap-2.5'>
			<span class='font-meta text-meta tracking-meta text-accent uppercase'>{post.tag}</span>
			{
				post.locked && (
					<span class='border-border text-muted rounded-pill border px-2 py-[3px] font-mono text-[10.5px] tracking-[0.06em] uppercase'>
						{post.tier}
					</span>
				)
			}
		</div>

		<h3 class='font-display tracking-heading mt-2.5 text-[22px] leading-[1.24] font-medium'>{post.title}</h3>
		<p class='text-small text-muted mt-2.5 leading-[1.58]'>{post.excerpt}</p>
		<p class='font-meta text-meta tracking-meta text-muted mt-3.5 uppercase'>{post.meta}</p>
	</a>
</article>
