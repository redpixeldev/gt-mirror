---
import type { DecoratedPost } from '../../data/posts';

/** A1 "magazine cover" lead: full-bleed photo, scrim, headline over the image. */
interface Props {
	post: DecoratedPost;
	href?: string;
	headingId?: string;
}

const { post, href = '#latest', headingId = 'a1-lead' } = Astro.props;
---

<section
	aria-labelledby={headingId}
	class='border-border relative border-b'>
	<div class='relative h-[min(76vh,660px)] overflow-hidden'>
		<img
			src={post.img}
			alt={post.alt}
			fetchpriority='high'
			decoding='async'
			class='block h-full w-full object-cover'
		/>

		<div
			aria-hidden='true'
			class='hero-scrim absolute inset-0'>
		</div>

		{/* Text colours are literal white here, not theme tokens — the scrim is dark in both themes. */}
		<div class='absolute inset-x-0 bottom-0 px-5 pb-14 md:px-8'>
			<div class='mx-auto max-w-[var(--container-max,1240px)]'>
				<div class='flex items-center gap-3.5'>
					<a
						href={href}
						class='font-meta tracking-meta border-b border-white/50 text-xs text-white uppercase no-underline'>
						{post.tag}
					</a>
					<span class='font-meta tracking-meta text-xs text-white/72 uppercase'>{post.meta}</span>
				</div>

				<h1
					id={headingId}
					class='font-display tracking-display mt-[18px] max-w-[20ch] text-[clamp(38px,5.4vw,72px)] leading-[1.03] font-medium text-balance text-white'>
					<a
						href={href}
						class='text-white no-underline'>
						{post.title}
					</a>
				</h1>

				<p class='text-lead mt-5 max-w-[56ch] leading-[1.5] text-pretty text-white/82'>{post.excerpt}</p>
			</div>
		</div>
	</div>
</section>
