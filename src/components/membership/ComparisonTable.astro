---
import type { CompareRow } from '../../data/membership';

/** "What's included" — the benefit matrix across the three tiers. */
interface Props {
	rows: CompareRow[];
	headingId?: string;
}

const { rows, headingId = 'compare-h' } = Astro.props;

const th = 'font-ui border-border border-b px-[18px] py-3.5 text-center text-[13px] font-semibold';
const td = 'border-border border-b px-[18px] py-3.5 text-center font-mono text-sm';
---

<section
	aria-labelledby={headingId}
	style='--container-max:1120px'
	class='container pt-20'>
	<h2
		id={headingId}
		class='font-ui text-muted mb-6 text-xs font-semibold tracking-[0.16em] uppercase'>
		What's included
	</h2>

	{
		/*
	  Below `stack` the four columns cannot fit: the table stops shrinking at its
	  min-content width, pushes the page wider than the viewport, and the rightmost
	  tier — Pro, the one being sold — is what falls off the edge. The list below
	  carries the same rows with each tier labelled, so nothing is cropped.
	*/
	}
	<table class='border-border max-stack:hidden w-full table-auto border-collapse overflow-hidden rounded-md border'>
		<thead>
			<tr class='bg-surface-2'>
				<th
					scope='col'
					class='border-border text-muted border-b px-[18px] py-3.5 text-left font-mono text-[10.5px] font-normal tracking-[0.08em] uppercase'>
					Benefit
				</th>
				<th
					scope='col'
					class:list={[th, 'w-[120px]']}>
					Free
				</th>
				<th
					scope='col'
					class:list={[th, 'w-[120px]']}>
					Basic
				</th>
				<th
					scope='col'
					class:list={[th, 'text-accent-strong w-[120px]']}>
					Pro
				</th>
			</tr>
		</thead>
		<tbody>
			{
				rows.map((row) => (
					<tr>
						<th
							scope='row'
							class='font-ui text-text border-border border-b px-[18px] py-3.5 text-left text-[14.5px] font-normal'>
							{row.label}
						</th>
						<td class:list={[td, row.free === '✓' ? 'text-text' : 'text-muted']}>{row.free}</td>
						<td class:list={[td, row.basic === '✓' ? 'text-text' : 'text-muted']}>{row.basic}</td>
						<td class:list={[td, 'text-accent']}>{row.pro}</td>
					</tr>
				))
			}
		</tbody>
	</table>

	<ul class='border-border stack:hidden m-0 grid list-none gap-0 overflow-hidden rounded-md border p-0'>
		{
			rows.map((row) => (
				<li class='border-border border-b p-[18px] last:border-b-0'>
					<p class='font-ui text-text text-[14.5px]'>{row.label}</p>
					<dl class='mt-3 grid grid-cols-3 gap-3'>
						{[
							{ tier: 'Free', value: row.free, accent: false },
							{ tier: 'Basic', value: row.basic, accent: false },
							{ tier: 'Pro', value: row.pro, accent: true },
						].map((cell) => (
							<div class='bg-surface-2 rounded-sm px-2 py-2 text-center'>
								<dt
									class:list={[
										'font-mono text-[10.5px] tracking-[0.08em] uppercase',
										cell.accent ? 'text-accent-strong' : 'text-muted',
									]}>
									{cell.tier}
								</dt>
								<dd
									class:list={[
										'mt-1 ml-0 font-mono text-sm',
										cell.accent ? 'text-accent' : cell.value === '✓' ? 'text-text' : 'text-muted',
									]}>
									{cell.value}
								</dd>
							</div>
						))}
					</dl>
				</li>
			))
		}
	</ul>
</section>
