---
import type { POST } from '../../data/post';

/** A1 "centered classic" head: full-bleed photo with caption, then centred titling. */
interface Props {
	post: typeof POST;
}

const { post } = Astro.props;
---

<figure class='border-border m-0 border-b'>
	<img
		src={post.img}
		alt={post.alt}
		fetchpriority='high'
		decoding='async'
		class='block h-[min(58vh,520px)] w-full object-cover'
	/>
	<figcaption class='font-ui text-muted container py-3 text-[13px]'>{post.caption}</figcaption>
</figure>

<div class='mx-auto max-w-[820px] px-5 pt-16 text-center md:px-8'>
	<p class='font-meta text-meta text-accent tracking-[0.16em] uppercase'>{post.tag}</p>

	<h1
		class='font-display tracking-display mt-[22px] text-[clamp(36px,5vw,64px)] leading-[1.04] font-medium text-balance'>
		{post.title}
	</h1>

	<p class='font-body text-muted mx-auto mt-[22px] max-w-[52ch] text-[21px] leading-[1.5] text-pretty italic'>
		{post.excerpt}
	</p>

	<div class='mt-7 flex items-center justify-center gap-3'>
		<span
			aria-hidden='true'
			class='bg-accent-soft font-ui text-accent-strong grid size-[34px] place-items-center rounded-full text-[13px] font-semibold'>
			{post.initials}
		</span>
		<span class='font-ui text-sm font-semibold'>{post.author}</span>
		<span class='font-meta text-meta tracking-meta text-muted uppercase'>{post.meta}</span>
	</div>
</div>
