---
/** Share row that closes the article body. */
const shareButton =
	'btn border-border bg-surface font-ui text-text hover:bg-surface-2 cursor-pointer rounded-sm border px-[15px] py-[9px] text-[13px] font-semibold';
---

<div class='border-border mt-8 flex flex-wrap items-center gap-3 border-t pt-7'>
	<span class='text-muted mr-1.5 font-mono text-[10.5px] tracking-[0.1em] uppercase'>Share</span>
	<button
		type='button'
		class={shareButton}>
		Copy link
	</button>
	<button
		type='button'
		class={shareButton}>
		Email
	</button>
	<button
		type='button'
		class={shareButton}>
		Bluesky
	</button>
</div>
