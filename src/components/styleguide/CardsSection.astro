---
import AuthorCard from '../cards/AuthorCard.astro';
import NewsletterCard from '../cards/NewsletterCard.astro';
import PaginationNav from '../cards/PaginationNav.astro';
import PostCard from '../cards/PostCard.astro';
import SectionHeading from './SectionHeading.astro';
---

<section class='pt-18'>
	<SectionHeading>06 — Post card, author card, newsletter, pagination</SectionHeading>

	<div class='grid grid-cols-[repeat(auto-fit,minmax(min(320px,100%),1fr))] gap-6'>
		<PostCard />

		<div class='flex flex-col gap-6'>
			<AuthorCard />
			<PaginationNav />
		</div>

		<NewsletterCard />
	</div>
</section>
