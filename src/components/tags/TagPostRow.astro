---
import type { TagArchivePost } from '../../data/tagArchive';
import PostListRow from '../PostListRow.astro';

/** A compact tag archive row: the date leads, the author signs off. */
interface Props {
	post: TagArchivePost;
	href?: string;
}

const { post, href = '#posts' } = Astro.props;
---

<PostListRow
	title={post.title}
	excerpt={post.excerpt}
	img={post.img}
	alt={post.alt}
	eyebrow={post.date}
	byline={`${post.author} · ${post.read}`}
	locked={post.locked}
	tier={post.tier}
	href={href}
/>
