---
import '../styles/main.css';

interface Props {
	title: string;
	description?: string;
	/** Overrides the `container` cap for this page, e.g. '1320px'. */
	contentWidth?: string;
}

const { title, description, contentWidth } = Astro.props;
---

<!doctype html>
<html lang='en'>
	<head>
		<meta charset='UTF-8' />
		<meta
			name='viewport'
			content='width=device-width,initial-scale=1.0'
		/>
		<title>{title}</title>
		{
			description && (
				<meta
					name='description'
					content={description}
				/>
			)
		}

		{/* Resolve the theme before first paint so dark mode never flashes light. */}
		<script is:inline>
			(() => {
				try {
					const stored = localStorage.getItem('mirror-theme');
					const dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
					document.documentElement.classList.toggle('dark', dark);
				} catch {
					/* private mode / storage disabled — light is the default */
				}
			})();
		</script>

		{
			/*
			The @font-face rules live in styles/fonts.css; these two hints just pull the
			latin faces off the critical path early. `crossorigin` is mandatory on font
			preloads — without it the browser fetches the file a second time.
		*/
		}
		<link
			rel='preload'
			href='/fonts/Newsreader-Variable-latin.woff2'
			as='font'
			type='font/woff2'
			crossorigin
		/>
		<link
			rel='preload'
			href='/fonts/Archivo-Regular.woff2'
			as='font'
			type='font/woff2'
			crossorigin
		/>

		<link
			rel='icon'
			type='image/png'
			sizes='32x32'
			href='/favicon.png'
		/>

		{/* Inline (not deferred) so the listener exists before Alpine boots below. */}
		<script is:inline>
			document.addEventListener('alpine:init', () => {
				Alpine.store('theme', {
					dark: document.documentElement.classList.contains('dark'),
					toggle() {
						this.dark = !this.dark;
						document.documentElement.classList.toggle('dark', this.dark);
						try {
							localStorage.setItem('mirror-theme', this.dark ? 'dark' : 'light');
						} catch {
							/* nothing to persist to */
						}
					},
					get label() {
						return this.dark ? 'Dark' : 'Light';
					},
				});

				/*
				 * Which header menu is open — one at a time, with a short grace period
				 * so a diagonal move from the label to a lower item does not lose it.
				 */
				Alpine.store('nav', {
					open: null,
					timer: null,
					show(key) {
						clearTimeout(this.timer);
						this.open = key;
					},
					hide() {
						clearTimeout(this.timer);
						this.timer = setTimeout(() => (this.open = null), 200);
					},
					hideNow() {
						clearTimeout(this.timer);
						this.open = null;
					},
				});
			});
		</script>

		<script
			defer
			src='https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js'
		></script>
	</head>
	<body
		class='bg-bg font-body text-text min-h-screen'
		style={contentWidth ? `--container-max:${contentWidth}` : undefined}>
		<slot />
	</body>
</html>
