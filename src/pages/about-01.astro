---
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import AboutBody from '@components/about/AboutBody.astro';
import CenteredIntro from '@components/CenteredIntro.astro';
import ContactSection from '@components/about/ContactSection.astro';
import StatsGrid from '@components/about/StatsGrid.astro';
import TeamGrid from '@components/about/TeamGrid.astro';
import NewsletterBanner from '@components/home/NewsletterBanner.astro';
import Layout from '@layouts/Layout.astro';
import { CONTACT_EMAIL, STATS } from '../data/about';
import { MASTHEAD } from '../data/authors';

const title = 'A publication for people who make publications';
const description =
	'Independent writing on media, craft, and the cost of attention — read in 74 countries, funded entirely by its members.';
---

<Layout
	title='About — Mirror'
	description={description}
	contentWidth='1320px'>
	<Header
		variant='site'
		compact
		current='about'
	/>

	<main id='about-top'>
		<CenteredIntro
			eyebrow='About The Quarry'
			title={title}
			description={description}
			headingId='a1-h'
		/>

		<StatsGrid stats={STATS} />

		<AboutBody />

		<TeamGrid team={MASTHEAD} />

		<ContactSection email={CONTACT_EMAIL} />

		<NewsletterBanner
			id='ab-cta'
			headingId='cta-head'
			inputId='ab-email'
			padding='pt-20'
		/>
	</main>

	<Footer
		variantLabel='Variant A1 · centered statement'
		titleWeight='medium'
		class='mt-24'
	/>
</Layout>
