---
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import AboutBody from '@components/about/AboutBody.astro';
import AboutHero from '@components/about/AboutHero.astro';
import ContactSection from '@components/about/ContactSection.astro';
import StatsGrid from '@components/about/StatsGrid.astro';
import TeamGrid from '@components/about/TeamGrid.astro';
import NewsletterBanner from '@components/home/NewsletterBanner.astro';
import Layout from '@layouts/Layout.astro';
import { CONTACT_EMAIL, STATS } from '../data/about';
import { MASTHEAD } from '../data/authors';

const navLinks = [
	{ label: 'Home', href: '#about-top' },
	{ label: 'Archive', href: '#about-top' },
	{ label: 'Authors', href: '#team' },
	{ label: 'About', href: '#about-top', current: true },
];

const footerColumns = [
	{
		title: 'Sections',
		ariaLabel: 'Sections',
		links: [
			{ label: 'Archive', href: '#about-top' },
			{ label: 'Tags', href: '#about-top' },
			{ label: 'Interviews', href: '#about-top' },
		],
	},
	{
		title: 'More',
		ariaLabel: 'More',
		links: [
			{ label: 'Authors', href: '#team' },
			{ label: 'Membership', href: '#ab-cta' },
			{ label: 'RSS', href: '#about-top' },
		],
	},
];

const title = 'A publication for people who make publications';
const description =
	'Independent writing on media, craft, and the cost of attention — read in 74 countries, funded entirely by its members.';
---

<Layout
	title='About — The Quarry'
	description={description}
	contentWidth='1320px'>
	<ThemeToggle />

	<Header
		variant='site'
		compact
		titleHref='#about-top'
		links={navLinks}
		subscribeHref='#ab-cta'
	/>

	<main id='about-top'>
		<AboutHero
			title={title}
			description={description}
		/>

		<StatsGrid stats={STATS} />

		<AboutBody />

		<TeamGrid team={MASTHEAD} />

		<ContactSection email={CONTACT_EMAIL} />

		<NewsletterBanner
			id='ab-cta'
			headingId='cta-head'
			inputId='ab-email'
			padding='pt-20'
		/>
	</main>

	<Footer
		columns={footerColumns}
		variantLabel='Variant A1 · centered statement'
		titleWeight='medium'
		class='mt-24'
	/>
</Layout>
