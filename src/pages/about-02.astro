---
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import AboutBody from '@components/about/AboutBody.astro';
import AboutSplitHero from '@components/about/AboutSplitHero.astro';
import ContactSection from '@components/about/ContactSection.astro';
import StatsGrid from '@components/about/StatsGrid.astro';
import TeamGrid from '@components/about/TeamGrid.astro';
import NewsletterBanner from '@components/home/NewsletterBanner.astro';
import Layout from '@layouts/Layout.astro';
import { CONTACT_EMAIL, STATS } from '../data/about';
import { MASTHEAD } from '../data/authors';

const title = 'A publication for people who make publications';
const description = 'Independent writing on media, craft, and the cost of attention — funded entirely by its members.';
---

<Layout
	title='About — Mirror'
	description={description}
	contentWidth='1320px'>
	<Header
		variant='site'
		compact
		current='about'
	/>

	<main id='about-top'>
		<AboutSplitHero
			title={title}
			description={description}
			image='/img/pexels-38048095.jpg'
			alt='Vintage roll-top writing desk with papers and office supplies'
		/>

		<StatsGrid
			stats={STATS}
			padding='pt-14'
		/>

		<AboutBody />

		<TeamGrid team={MASTHEAD} />

		<ContactSection email={CONTACT_EMAIL} />

		<NewsletterBanner
			id='ab-cta'
			headingId='cta-head'
			inputId='ab-email'
			padding='pt-20'
		/>
	</main>

	<Footer
		variantLabel='Variant A2 · split hero'
		titleWeight='medium'
		class='mt-24'
	/>
</Layout>
