---
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import AuthorList from '@components/authors/AuthorList.astro';
import PageIntro from '@components/PageIntro.astro';
import NewsletterBanner from '@components/home/NewsletterBanner.astro';
import Layout from '@layouts/Layout.astro';
import { AUTHOR_TOTAL, MASTHEAD } from '../data/authors';

const intro = `${AUTHOR_TOTAL} people write here. Between them they have filed 104 pieces since 2020.`;
---

<Layout
	title='Writers — The Quarry'
	description={intro}
	contentWidth='1320px'>
	<ThemeToggle />

	<Header
		variant='site'
		compact
		current='authors'
	/>

	<main>
		<PageIntro
			eyebrow='The masthead'
			title='Writers'
			description={intro}
			headingId='au-title'
		/>

		<AuthorList authors={MASTHEAD} />

		<NewsletterBanner
			id='au-cta'
			headingId='cta-head'
			inputId='au-email'
			title={`Read all ${AUTHOR_TOTAL} writers, every Thursday`}
			padding='pt-20'
		/>
	</main>

	<Footer
		variantLabel='Variant A1 · editorial rows'
		titleWeight='medium'
		class='mt-24'
	/>
</Layout>
