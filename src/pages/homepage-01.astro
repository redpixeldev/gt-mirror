---
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import PaginationNav from '@components/cards/PaginationNav.astro';
import FeaturedCarousel from '@components/home/FeaturedCarousel.astro';
import HeroLead from '@components/home/HeroLead.astro';
import LatestSection from '@components/home/LatestSection.astro';
import NewsletterBanner from '@components/home/NewsletterBanner.astro';
import WritersSection from '@components/home/WritersSection.astro';
import Layout from '@layouts/Layout.astro';
import { ALL_POSTS, AUTHORS, TAGS } from '../data/posts';

// Slices follow the source's `renderVals()` for layout A1.
const lead = ALL_POSTS[0];
const featured = ALL_POSTS.filter((post) => post.featured);
const big = ALL_POSTS[1];
const mediums = ALL_POSTS.slice(2, 5);
const grid = ALL_POSTS.slice(5, 12);
---

<Layout
	title='The Quarry — Independent writing on media, craft, and the cost of attention'
	description='A magazine-cover homepage for the MIRROR Ghost theme: featured essays, interviews and field notes from The Quarry.'
	contentWidth='1320px'>
	<ThemeToggle />

	<Header
		variant='site'
		current='home'
	/>

	<main id='top'>
		<HeroLead post={lead} />
		<FeaturedCarousel posts={featured} />
		<LatestSection
			lead={big}
			mediums={mediums}
			grid={grid}
			tags={TAGS}
		/>
		<NewsletterBanner />
		<WritersSection authors={AUTHORS} />

		<section
			aria-label='Pagination'
			class='container pt-14'>
			<PaginationNav
				framed={false}
				size='md'
			/>
		</section>
	</main>

	<Footer
		variantLabel='Variant A1 · magazine cover'
		titleWeight='medium'
		class='mt-24'
	/>
</Layout>
