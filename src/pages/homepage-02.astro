---
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import PaginationNav from '@components/cards/PaginationNav.astro';
import MastheadLead from '@components/home/MastheadLead.astro';
import NewsletterBanner from '@components/home/NewsletterBanner.astro';
import WeeklyDigestSection from '@components/home/WeeklyDigestSection.astro';
import WritersSection from '@components/home/WritersSection.astro';
import Layout from '@layouts/Layout.astro';
import { ALL_POSTS, AUTHORS, TAGS } from '../data/posts';

// Slices follow the source's `renderVals()` for layout A2.
const lead = ALL_POSTS[0];
const topThree = ALL_POSTS.slice(1, 4);
const eight = ALL_POSTS.slice(4, 12);
---

<Layout
	title='Mirror — Independent writing on media, craft, and the cost of attention'
	description='An editorial-masthead homepage for the MIRROR Ghost theme: a lead essay, the week’s shortlist, and the archive from The Quarry.'
	contentWidth='1320px'>
	<Header
		variant='site'
		current='home'
	/>

	<main id='top'>
		{/* A2 sets the article column to 1120px; the blocks below it stay page-width. */}
		<div style='--container-max:1120px'>
			<MastheadLead post={lead} />
			<WeeklyDigestSection
				rows={topThree}
				grid={eight}
				tags={TAGS}
			/>

			<section
				aria-label='Pagination'
				class='container pt-14'>
				<PaginationNav
					framed={false}
					size='md'
				/>
			</section>
		</div>

		<NewsletterBanner />
		<WritersSection authors={AUTHORS} />
	</main>

	<Footer
		variantLabel='Variant A2 · editorial masthead'
		titleWeight='medium'
		class='mt-24'
	/>
</Layout>
