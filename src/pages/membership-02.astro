---
import MembershipSplitHero from '@components/membership/MembershipSplitHero.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import NewsletterBanner from '@components/home/NewsletterBanner.astro';
import ComparisonTable from '@components/membership/ComparisonTable.astro';
import FaqAccordion from '@components/membership/FaqAccordion.astro';
import LockedPosts from '@components/membership/LockedPosts.astro';
import MemberQuoteRows from '@components/membership/MemberQuoteRows.astro';
import PricingTiers from '@components/membership/PricingTiers.astro';
import Layout from '@layouts/Layout.astro';
import { COMPARE, FAQS, LOCKED_POSTS, QUOTES, TIERS } from '../data/membership';

const description =
	'No advertising, no sponsorship, no affiliate links. The Quarry is funded by the people who read it — and that is the whole business model.';
---

<Layout
	title='Membership — Mirror'
	description={description}
	contentWidth='1320px'>
	<ThemeToggle />

	<Header
		variant='site'
		compact
		current='membership'
	/>

	<main id='mem-top'>
		<MembershipSplitHero
			title='Pay five writers, read everything'
			description={description}
		/>

		<PricingTiers
			tiers={TIERS}
			padding='pt-14'
		/>

		<ComparisonTable rows={COMPARE} />

		<LockedPosts posts={LOCKED_POSTS} />

		<MemberQuoteRows quotes={QUOTES} />

		<FaqAccordion faqs={FAQS} />

		<NewsletterBanner
			id='mem-cta'
			headingId='cta-head'
			inputId='mem-email'
			eyebrow='Start free'
			title='Read the Thursday essay first'
			description='Free membership takes an email address and nothing else. Upgrade whenever the interviews start to matter.'
			submitLabel='Join free'
			padding='pt-20'
		/>
	</main>

	<Footer
		variantLabel='Variant A2 · editorial split'
		titleWeight='medium'
		class='mt-24'
	/>
</Layout>
