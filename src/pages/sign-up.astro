---
import Header from '@components/Header.astro';
import AuthShell from '@components/auth/AuthShell.astro';
import FormStateSwitch from '@components/auth/FormStateSwitch.astro';
import SignUpForm from '@components/auth/SignUpForm.astro';
import UpgradePrompt from '@components/auth/UpgradePrompt.astro';
import Layout from '@layouts/Layout.astro';
import { ROUTES } from '../data/navigation';

const subhead = 'Free members get the Thursday essay and the full public archive.';
---

<Layout
	title='Sign up — Mirror'
	description={subhead}
	contentWidth='1320px'>
	{/* `?state=loading|success|error` opens the page in that state — handy for demos and screenshots. */}
	<div
		x-data="{ state: ['loading', 'success', 'error'].includes(new URLSearchParams(location.search).get('state'))
			? new URLSearchParams(location.search).get('state')
			: 'default' }"
		class='flex min-h-screen flex-col'>
		<FormStateSwitch />

		<Header
			variant='auth'
			titleHref={ROUTES.home}
		/>

		<AuthShell
			eyebrow='Free membership'
			title='Sign up'
			subhead={subhead}
			subheadWidth='max-w-[42ch]'>
			<SignUpForm />

			<Fragment slot='footnotes'>
				<UpgradePrompt />

				<p class='font-ui text-muted mt-6 text-center text-sm'>
					Already a member? <a
						href={ROUTES.signIn}
						class='text-accent underline'
						>Sign in</a
					>
				</p>
				<p class='text-muted mt-3.5 text-center font-mono text-[11px]'>
					<a
						href='#'
						class='text-muted underline'
						>Privacy</a
					> · <a
						href='#'
						class='text-muted underline'
						>Terms</a
					>
				</p>
			</Fragment>
		</AuthShell>
	</div>
</Layout>
