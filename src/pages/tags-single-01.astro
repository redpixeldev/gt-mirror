---
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import PaginationNav from '@components/cards/PaginationNav.astro';
import NewsletterBanner from '@components/home/NewsletterBanner.astro';
import OtherTagsSection from '@components/tags/OtherTagsSection.astro';
import TagArchiveHeader from '@components/tags/TagArchiveHeader.astro';
import TagPostList from '@components/tags/TagPostList.astro';
import Layout from '@layouts/Layout.astro';
import { OTHER_TAGS, TAG, TAG_COUNT_LABEL, TAG_POSTS } from '../data/tagArchive';
---

<Layout
	title={`${TAG.name} — The Quarry`}
	description={TAG.description}
	contentWidth='1320px'>
	<ThemeToggle />

	<Header
		variant='site'
		compact
		current='tags'
	/>

	<main id='tag-top'>
		<TagArchiveHeader
			name={TAG.name}
			description={TAG.description}
			countLabel={TAG_COUNT_LABEL}
			range={TAG.range}
		/>

		<TagPostList
			posts={TAG_POSTS}
			tagName={TAG.name}
		/>

		<section
			aria-label='Pagination'
			class='container pt-13'>
			<PaginationNav
				pages={[1, 2]}
				current={1}
				framed={false}
				size='md'
			/>
		</section>

		<OtherTagsSection tags={OTHER_TAGS} />

		<NewsletterBanner
			id='tag-cta'
			headingId='cta-head'
			inputId='ta-email'
			title={`Never miss an ${TAG.singular}`}
			description='Free members get the archive. Paid members get the full transcripts and the annual field report.'
			titleWidth='max-w-[26ch]'
			padding='pt-18'
		/>
	</main>

	<Footer
		variantLabel='Variant A1 · lead + list'
		titleWeight='medium'
		class='mt-24'
	/>
</Layout>
